{
    "name": "gwharton/module-notosans",
    "description": "GWharton NotoSans Module",
    "type": "magento2-library",
    "require": {
        "magento/framework": "*"
    },
    "license": [
        "OSL-3.0"
    ],
    "extra": {
        "map": [
            [
                "lib/internal/NotoSans/*",
                "NotoSans"
            ],
            [
                "lib/internal/NotoSans-arabic/*",
                "NotoSans-arabic"
            ],
            [
                "lib/internal/NotoSans-cjk/*",
                "NotoSans-cjk"
            ]
        ]
    }
}
